# Copie para Streamlit Cloud → Settings → Secrets
# Main file do app: streamlit_app.py

FPT_API_KEY = "sua_chave_fpt"

[betfair]
username = "seu_email_betfair"
password = "sua_senha"
app_key = "sua_app_key"
# Cole o conteúdo COMPLETO dos arquivos (incluindo BEGIN/END):
cert_pem = """
-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----
"""
key_pem = """
-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----
"""

[execution]
enabled = true
paper_mode = true
auto_execute = false

# Opcional — URL pública de zip com model_outcome.joblib etc. (pula treino)
# MODELS_ZIP_URL = "https://..."
