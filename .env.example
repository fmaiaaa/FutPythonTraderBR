# === FutPythonTrader (OBRIGATORIO) ===
# https://futpythontrader.com.br/dashboard
FPT_API_KEY=COLE_SUA_API_KEY_AQUI

# === The Odds API (opcional — odds live multi-casa, ~500 req/mes free) ===
# https://the-odds-api.com/ — util para VALIDAR preco vs FPT (nao substitui historico/stats)
THE_ODDS_API_KEY=
THE_ODDS_MONTHLY_BUDGET=500

# === Betfair Exchange BR (certificado — betfair.bet.br) ===
# Tutorial: docs/betfair/README.md
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_APP_KEY=
BETFAIR_CERT_PATH=C:/Users/kaleb/FutPythonTraderBR/certs
BETFAIR_ENABLED=false

# === Google Drive (CI/GitHub Secrets — OAuth recomendado) ===
# Veja docs/GOOGLE_DRIVE_SETUP.md
# Local opcional; no CI use: GOOGLE_OAUTH_* + GOOGLE_DRIVE_FOLDER_ID nos GitHub Secrets
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER=FutPythonTrader-Semanal
